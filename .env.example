# AI-Powered PowerPoint Generator — Environment Configuration
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.

# -------------------------------------------------------
# Groq Cloud API
# Get your key at: https://console.groq.com/keys
# -------------------------------------------------------
GROQ_API_KEY=your_groq_api_key_here

# -------------------------------------------------------
# Model selection (optional — defaults shown below)
# Recommended: openai/gpt-oss-120b (best reasoning & structure adherence)
# Alternatives: openai/gpt-oss-20b, qwen/qwen3.6-27b
# -------------------------------------------------------
GROQ_MODEL=openai/gpt-oss-120b

# -------------------------------------------------------
# Generation settings (optional)
# -------------------------------------------------------
# Maximum tokens for planning stage
GROQ_MAX_TOKENS_PLAN=4096

# Maximum tokens for per-slide content generation
GROQ_MAX_TOKENS_SLIDE=2048

# Temperature (0.0 = deterministic, 1.0 = creative)
GROQ_TEMPERATURE=0.3

# Maximum retries on JSON parse failure
LLM_MAX_RETRIES=3

# -------------------------------------------------------
# Application settings (optional)
# -------------------------------------------------------
# Maximum file upload size in MB
MAX_UPLOAD_SIZE_MB=20

# Maximum source text length sent to LLM (characters)
MAX_SOURCE_TEXT_CHARS=12000

# Output directory (relative to project root)
OUTPUT_DIR=output

# Exact semantic LLM response cache. Set false to disable without deleting data.
SEMANTIC_CACHE_ENABLED=true
SEMANTIC_CACHE_PATH=logs/semantic_cache.sqlite3

# Number of newest generated presentations to retain. Set to 0 to keep all.
OUTPUT_RETENTION_COUNT=50

# Input safety controls. Keep enabled in deployed environments.
GUARDRAILS_ENABLED=true

# Rolling semantic context budget. Earlier sections are compacted when needed.
CONTEXT_COMPACTION_MAX_CHARS=2000
CONTEXT_COMPACTION_RECENT_LINES=6
